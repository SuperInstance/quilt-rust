{
 "contract": "quilt-compat/1",
 "spec": {
  "edge_schema_v": 1,
  "reference_tier": "rust (quilt-core: ledger.rs + engine.rs)",
  "canonical_json": "compact; object keys sorted by UTF-8 byte order; integers as integers; floats as shortest-round-trip decimal (ryu); strings via standard JSON escaping",
  "wire_ts": "float milliseconds since unix epoch",
  "provenance": "sha256_hex(canonical_json(inputs)) where inputs is the JSON array of input values in dependency-address order",
  "imbalance_prior": "persistence (predict(before) = before); null when no prior exists - never fake a number"
 },
