   {
    "id": "bilge.level",
    "kind": "sensor",
    "source": "simulated",
    "default": 40.0
   },
   {
    "id": "bilge.threshold",
    "kind": "value",
    "value": 80.0
   },
   {
    "id": "pump.should_run",
    "kind": "formula",
    "expr": "=bilge.level >= bilge.threshold"
   },
   {
    "id": "pump.relay_cmd",
    "kind": "formula",
    "expr": "=clamp((bilge.level - bilge.threshold) * 0.5, -30.0, 30.0)"
   },
   {
    "id": "status",
    "kind": "value",
    "value": "idle"
   }
  ]
 },
