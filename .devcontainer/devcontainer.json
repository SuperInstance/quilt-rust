{
  "name": "Quilt Cortex (Rust)",
  "image": "mcr.microsoft.com/devcontainers/rust:1-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    }
  },
  "remoteEnv": {
    "CARGO_INCREMENTAL": "0",
    "FLEET_RELAY_URL": "${localEnv:FLEET_RELAY_URL}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "tamasfe.even-better-toml",
        "serayuzgur.crates",
        "github.vscode-pull-request-github",
        "streetsidesoftware.code-spell-checker"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "rust-analyzer.check.command": "clippy",
        "[rust]": {
          "editor.defaultFormatter": "rust-lang.rust-analyzer"
        },
        "[toml]": {
          "editor.defaultFormatter": "tamasfe.even-better-toml"
        }
      }
    },
    "codespaces": {
      "openFiles": [
        "cortex/agenda.md",
        "docs/codespace-cortex.md"
      ]
    }
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "quilt-web (HTTP + SSE)",
      "onAutoForward": "silent"
    }
  },
  "hostRequirements": {
    "cpus": 2,
    "memory": 8
  },
  "postCreateCommand": "rustup component add rustfmt clippy && cargo build && cargo test",
  "postStartCommand": "echo '── cortex awake: read the agenda first ──' && cat cortex/agenda.md && echo '── last five commits (episodic memory) ──' && git log --oneline -5",
  "remoteUser": "vscode"
}
